# VITE_SUPABASE_PROJECT_ID=local

# =====================================================
# STRIPE CONFIGURATION (For Payments / Pour les paiements)
# =====================================================
# Get these from https://dashboard.stripe.com/apikeys
# Récupérez ces valeurs depuis https://dashboard.stripe.com/apikeys

# Publishable key (safe to expose in frontend)
# Clé publique (peut être exposée côté client)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# =====================================================
# EDGE FUNCTIONS SECRETS (Set via Supabase CLI)
# =====================================================
# These secrets must be configured in Supabase, not in this file
# Ces secrets doivent être configurés dans Supabase, pas dans ce fichier
#
# Use: supabase secrets set SECRET_NAME=value
# 
# Required secrets for Edge Functions:
# Secrets requis pour les Edge Functions:
#
# STRIPE_SECRET_KEY=sk_test_...
#   - Stripe secret key for server-side operations
#   - Clé secrète Stripe pour les opérations côté serveur
#
# STRIPE_WEBHOOK_SECRET=whsec_...
#   - Stripe webhook signing secret
#   - Secret de signature des webhooks Stripe
#
# PANDASCORE_API_KEY=your_pandascore_api_key
#   - PandaScore API key for esports match data
#   - Clé API PandaScore pour les données de matchs esport
#
# RESEND_API_KEY=re_...
#   - Resend API key for sending emails
#   - Clé API Resend pour l'envoi d'emails

# =====================================================
# OPTIONAL: ANALYTICS & MONITORING
# =====================================================
# Uncomment and configure if using these services
# Décommentez et configurez si vous utilisez ces services

# Google Analytics
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry for error tracking
# VITE_SENTRY_DSN=https://xxxx@sentry.io/xxxx

# PostHog for product analytics
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://app.posthog.com

# =====================================================
# OPTIONAL: FEATURE FLAGS
# =====================================================
# Enable/disable features during development
# Activer/désactiver des fonctionnalités en développement

# VITE_ENABLE_DEMO_MODE=true
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_ERROR_TRACKING=false

# =====================================================
# OPTIONAL: API ENDPOINTS
# =====================================================
# Override default API endpoints if needed
# Surcharger les endpoints API par défaut si nécessaire

# VITE_API_BASE_URL=https://api.esportarena.com
# VITE_CDN_URL=https://cdn.esportarena.com

# =====================================================
# DEVELOPMENT SETTINGS
# =====================================================
# Settings specific to development environment
# Paramètres spécifiques à l'environnement de développement

# Enable debug logging
# VITE_DEBUG=true

# Mock external APIs
# VITE_MOCK_APIS=false

# =====================================================
# NOTES
# =====================================================
# 
# 1. Never commit .env or .env.local files to git
#    Ne jamais commiter les fichiers .env ou .env.local
#
# 2. VITE_ prefix is required for frontend access
#    Le préfixe VITE_ est requis pour l'accès côté client
#
# 3. Secrets without VITE_ prefix are server-side only
#    Les secrets sans préfixe VITE_ sont côté serveur uniquement
#
# 4. Use different values for development/staging/production
#    Utilisez des valeurs différentes pour dev/staging/prod
#
# =====================================================
