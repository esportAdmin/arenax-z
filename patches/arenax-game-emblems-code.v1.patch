@@ -0,0 +1,118 @@
+import * as React from "react";
+
+const DEFAULT_GAME_KEY = "artifact";
+
+const GAME_KEY_TO_ASSET: Record<string, string> = {
+  // FPS
+  cs2: "cs2",
+  csgo: "cs2",
+  "cs-go": "cs2",
+  counterstrike: "cs2",
+  "counter-strike": "cs2",
+  valorant: "valorant",
+  overwatch: "overwatch",
+  "overwatch 2": "overwatch",
+  halo: "halo",
+  rainbow6: "rainbowsix",
+  "rainbow six": "rainbowsix",
+  r6: "rainbowsix",
+  r6siege: "rainbowsix",
+
+  // MOBA
+  lol: "lol",
+  "league of legends": "lol",
+  wildrift: "wildrift",
+  "wild rift": "wildrift",
+  dota2: "dota2",
+  "dota 2": "dota2",
+
+  // Sports / BR / Others
+  fifa: "fifa",
+  pubg: "pubg",
+  "rocket league": "rocketleague",
+  rocketleague: "rocketleague",
+  "call of duty": "callofduty",
+  cod: "callofduty",
+  hearthstone: "hearthstone",
+  "heroes of the storm": "heroesofthestorm",
+  heroesofthestorm: "heroesofthestorm",
+  pokemon: "pokemon",
+};
+
+/**
+ * normalizeGameKey
+ *
+ * @example
+ * normalizeGameKey("CS:GO"); // "cs-go"
+ */
+function normalizeGameKey(input: string) {
+  return input
+    .trim()
+    .toLowerCase()
+    .replace(/_/g, " ")
+    .replace(/\s+/g, " ")
+    .replace(/[^\w\s:-]/g, "");
+}
+
+/**
+ * getGameEmblemSrc
+ *
+ * Resolves a match.game string to a local emblem in /public/images/game-emblems.
+ *
+ * @example
+ * getGameEmblemSrc("CS2"); // "/images/game-emblems/cs2.svg"
+ */
+export function getGameEmblemSrc(game: string | null | undefined) {
+  const raw = (game ?? "").trim();
+  if (!raw) return `/images/game-emblems/${DEFAULT_GAME_KEY}.svg`;
+
+  const key = normalizeGameKey(raw);
+
+  // Fast-path exact matches
+  const asset =
+    GAME_KEY_TO_ASSET[key] ??
+    // common variants
+    GAME_KEY_TO_ASSET[key.replace(/\s+/g, "")] ??
+    GAME_KEY_TO_ASSET[key.replace(/:/g, "")] ??
+    DEFAULT_GAME_KEY;
+
+  return `/images/game-emblems/${asset}.svg`;
+}
+
+export type GameEmblemProps = {
+  game: string;
+  size?: number;
+  className?: string;
+};
+
+/**
+ * GameEmblem
+ *
+ * Uses a plain <img> to avoid Next/Image SVG edge-cases.
+ *
+ * @example
+ * <GameEmblem game="CS2" />
+ */
+export function GameEmblem({ game, size = 14, className }: GameEmblemProps) {
+  const src = getGameEmblemSrc(game);
+
+  return (
+    <img
+      src={src}
+      alt={game}
+      width={size}
+      height={size}
+      loading="lazy"
+      className={className ?? "inline-block opacity-90"}
+      style={{ width: size, height: size }}
+    />
+  );
+}
