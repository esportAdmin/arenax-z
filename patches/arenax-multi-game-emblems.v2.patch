+"use client";
+
+import * as React from "react";
+
+type GameKey =
+  | "artifact"
+  | "callofduty"
+  | "cs2"
+  | "dota2"
+  | "fifa"
+  | "halo"
+  | "hearthstone"
+  | "heroesofthestorm"
+  | "lol"
+  | "overwatch"
+  | "pokemon"
+  | "pubg"
+  | "rainbowsix"
+  | "rocketleague"
+  | "valorant"
+  | "wildrift";
+
+const GAME_EMBLEM_SRC: Record<GameKey, string> = {
+  artifact: "/images/game-emblems/artifact.svg",
+  callofduty: "/images/game-emblems/callofduty.svg",
+  cs2: "/images/game-emblems/cs2.svg",
+  dota2: "/images/game-emblems/dota2.svg",
+  fifa: "/images/game-emblems/fifa.svg",
+  halo: "/images/game-emblems/halo.svg",
+  hearthstone: "/images/game-emblems/hearthstone.svg",
+  heroesofthestorm: "/images/game-emblems/heroesofthestorm.svg",
+  lol: "/images/game-emblems/lol.svg",
+  overwatch: "/images/game-emblems/overwatch.svg",
+  pokemon: "/images/game-emblems/pokemon.svg",
+  pubg: "/images/game-emblems/pubg.svg",
+  rainbowsix: "/images/game-emblems/rainbowsix.svg",
+  rocketleague: "/images/game-emblems/rocketleague.svg",
+  valorant: "/images/game-emblems/valorant.svg",
+  wildrift: "/images/game-emblems/wildrift.svg",
+};
+
+const ALIASES: Record<string, GameKey> = {
+  // CS / Counter-Strike
+  "cs2": "cs2",
+  "cs:go": "cs2",
+  "csgo": "cs2",
+  "cs-go": "cs2",
+  "counter strike": "cs2",
+  "counter-strike": "cs2",
+  "counter-strike 2": "cs2",
+
+  // League
+  "lol": "lol",
+  "league of legends": "lol",
+  "league-of-legends": "lol",
+
+  // Dota
+  "dota2": "dota2",
+  "dota 2": "dota2",
+
+  // Valorant
+  "valorant": "valorant",
+
+  // Overwatch
+  "overwatch": "overwatch",
+  "ow": "overwatch",
+
+  // Rocket League
+  "rocketleague": "rocketleague",
+  "rocket league": "rocketleague",
+
+  // PUBG
+  "pubg": "pubg",
+  "pubg battlegrounds": "pubg",
+  "playerunknown's battlegrounds": "pubg",
+
+  // Rainbow Six
+  "rainbowsix": "rainbowsix",
+  "rainbow six": "rainbowsix",
+  "r6": "rainbowsix",
+  "r6s": "rainbowsix",
+  "rainbow six siege": "rainbowsix",
+
+  // Wild Rift
+  "wildrift": "wildrift",
+  "wild rift": "wildrift",
+  "lol wild rift": "wildrift",
+
+  // Others
+  "call of duty": "callofduty",
+  "callofduty": "callofduty",
+  "cod": "callofduty",
+  "halo": "halo",
+  "fifa": "fifa",
+  "hearthstone": "hearthstone",
+  "heroes of the storm": "heroesofthestorm",
+  "heroesofthestorm": "heroesofthestorm",
+  "hots": "heroesofthestorm",
+  "pokemon": "pokemon",
+  "pokémon": "pokemon",
+  "artifact": "artifact",
+};
+
+function normalizeGameKey(input: string | null | undefined): GameKey | null {
+  if (!input) return null;
+  const cleaned = input
+    .toLowerCase()
+    .replaceAll("_", " ")
+    .replaceAll("-", " ")
+    .replaceAll(":", "")
+    .replace(/\s+/g, " ")
+    .trim();
+
+  // direct hit
+  if (cleaned in ALIASES) return ALIASES[cleaned];
+
+  // heuristic contains checks (handles strings like "CCT Europe (CS2)")
+  for (const [k, v] of Object.entries(ALIASES)) {
+    if (cleaned.includes(k)) return v;
+  }
+  return null;
+}
+
+export interface GameEmblemProps {
+  game: string;
+  size?: number;
+  className?: string;
+  title?: string;
+}
+
+/**
+ * GameEmblem
+ *
+ * Renders a local SVG emblem for a given game string. Falls back to initials if missing.
+ *
+ * @example
+ * <GameEmblem game="CS2" size={18} />
+ */
+export function GameEmblem({ game, size = 18, className, title }: GameEmblemProps) {
+  const [errored, setErrored] = React.useState(false);
+  const key = React.useMemo(() => normalizeGameKey(game), [game]);
+  const src = key ? GAME_EMBLEM_SRC[key] : null;
+
+  if (!src || errored) {
+    const initials =
+      (game || "??")
+        .split(/\s+/g)
+        .filter(Boolean)
+        .slice(0, 2)
+        .map((s) => s.slice(0, 1).toUpperCase())
+        .join("") || "??";
+
+    return (
+      <div
+        className={
+          "inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 text-[10px] font-semibold text-white/70 " +
+          (className ?? "")
+        }
+        style={{ width: size, height: size }}
+        aria-label={title ?? game}
+        title={title ?? game}
+      >
+        {initials}
+      </div>
+    );
+  }
+
+  return (
+    <img
+      src={src}
+      width={size}
+      height={size}
+      className={"inline-block select-none " + (className ?? "")}
+      alt={title ?? game}
+      title={title ?? game}
+      loading="lazy"
+      onError={() => setErrored(true)}
+    />
+  );
+}
