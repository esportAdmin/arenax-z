+  | "pokemon"
+  | "pubg"
+  | "rainbowsix"
+  | "rocketleague"
+  | "valorant"
+  | "wildrift";
+
+export type GameEmblem = {
+  key: GameEmblemKey;
+  name: string;
+  /** Local public path (served from /public) */
+  src: string;
+};
+
+const GAME_EMBLEMS: Record<GameEmblemKey, GameEmblem> = {
+  artifact: {
+    key: "artifact",
+    name: "Artifact",
+    src: "/images/game-emblems/artifact.svg",
