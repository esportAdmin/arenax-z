+    name: "Heroes of the Storm",
+    src: "/images/game-emblems/heroesofthestorm.svg",
+  },
+  lol: {
+    key: "lol",
+    name: "League of Legends",
+    src: "/images/game-emblems/lol.svg",
+  },
+  overwatch: {
+    key: "overwatch",
+    name: "Overwatch",
+    src: "/images/game-emblems/overwatch.svg",
+  },
+  pokemon: {
+    key: "pokemon",
+    name: "Pokémon",
+    src: "/images/game-emblems/pokemon.svg",
+  },
+  pubg: {
+    key: "pubg",
+    name: "PUBG",
+    src: "/images/game-emblems/pubg.svg",
+  },
+  rainbowsix: {
+    key: "rainbowsix",
+    name: "Rainbow Six",
+    src: "/images/game-emblems/rainbowsix.svg",
+  },
+  rocketleague: {
+    key: "rocketleague",
+    name: "Rocket League",
+    src: "/images/game-emblems/rocketleague.svg",
+  },
+  valorant: {
+    key: "valorant",
+    name: "Valorant",
+    src: "/images/game-emblems/valorant.svg",
+  },
+  wildrift: {
+    key: "wildrift",
+    name: "Wild Rift",
+    src: "/images/game-emblems/wildrift.svg",
+  },
+};
+
+const ALIAS_TO_KEY: Record<string, GameEmblemKey> = {
+  // CS2 / CS:GO
+  cs2: "cs2",
+  csgo: "cs2",
+  csg: "cs2",
+  counterstrike: "cs2",
+  counterstrike2: "cs2",
+  counterstrikeglobaloffensive: "cs2",
+
+  // Valorant
+  valorant: "valorant",
+  val: "valorant",
+
+  // Dota
+  dota: "dota2",
+  dota2: "dota2",
+
+  // League
+  lol: "lol",
+  leagueoflegends: "lol",
+  league: "lol",
+
+  // Wild Rift
+  wildrift: "wildrift",
+  leagueoflegendswildrift: "wildrift",
+
+  // R6
+  rainbowsix: "rainbowsix",
+  rainbowsixsiege: "rainbowsix",
+  r6: "rainbowsix",
+  r6siege: "rainbowsix",
+
+  // Rocket League
+  rocketleague: "rocketleague",
+  rl: "rocketleague",
+
+  // Call of Duty
+  callofduty: "callofduty",
+  cod: "callofduty",
+
+  // Overwatch
+  overwatch: "overwatch",
+  ow: "overwatch",
+
+  // Hearthstone
+  hearthstone: "hearthstone",
+  hs: "hearthstone",
+
+  // HoTS
+  heroesofthestorm: "heroesofthestorm",
+  hots: "heroesofthestorm",
+
+  // PUBG
+  pubg: "pubg",
+  playerunknownsbattlegrounds: "pubg",
+
+  // FIFA / EA FC
+  fifa: "fifa",
+  eafc: "fifa",
+  easportsfc: "fifa",
+  fc24: "fifa",
+
+  // Pokémon
+  pokemon: "pokemon",
+
+  // Artifact
+  artifact: "artifact",
+
+  // Halo
+  halo: "halo",
+  haloinfinite: "halo",
+};
+
+/**
+ * normalizeGameKey
+ *
+ * Turns "CS:GO" or "League of Legends" into a stable lookup key.
+ *
+ * @example
+ * normalizeGameKey("CS:GO");
+ * // => "csgo"
+ */
+export function normalizeGameKey(game: string) {
+  return game.toLowerCase().replace(/[^a-z0-9]/g, "");
+}
+
+/**
+ * getGameEmblem
+ *
+ * @example
+ * getGameEmblem("CS2")?.src;
+ * // => "/images/game-emblems/cs2.svg"
+ */
+export function getGameEmblem(game: string | null | undefined): GameEmblem | null {
+  if (!game) return null;
+  const normalized = normalizeGameKey(game);
+  const key = ALIAS_TO_KEY[normalized];
+  if (!key) return null;
+  return GAME_EMBLEMS[key] ?? null;
+}
+
+/**
+ * getGameEmblemSrc
+ *
+ * @example
+ * getGameEmblemSrc("Valorant");
+ * // => "/images/game-emblems/valorant.svg"
+ */
+export function getGameEmblemSrc(game: string | null | undefined): string | null {
+  return getGameEmblem(game)?.src ?? null;
+}
+
+/**
+ * getGameEmblemName
+ *
+ * @example
+ * getGameEmblemName("lol");
+ * // => "League of Legends"
+ */
+export function getGameEmblemName(game: string | null | undefined): string | null {
+  return getGameEmblem(game)?.name ?? null;
+}
+
+export const SUPPORTED_GAME_EMBLEM_KEYS = Object.keys(GAME_EMBLEMS) as GameEmblemKey[];
+
+export function isSupportedGameEmblemKey(key: string): key is GameEmblemKey {
+  return (SUPPORTED_GAME_EMBLEM_KEYS as readonly string[]).includes(key);
+}
+
