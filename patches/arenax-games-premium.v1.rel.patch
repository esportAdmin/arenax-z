+    { id: "dota2", name: "DOTA 2", players: "1.2M Players", live: true, accent: "blue", size: "featured" },
+    { id: "csgo", name: "CS:GO", players: "850K Players", live: true, accent: "yellow", size: "featured" },
+    { id: "valorant", name: "Valorant", players: "600K Players", live: true, accent: "red", size: "featured" },
+  ];
+
+  const competitive: GameCard[] = [
+    { id: "csgo", name: "CS:GO", players: "1.2M Players", live: true, accent: "blue", size: "compact" },
+    { id: "valorant", name: "Valorant", players: "850K Players", live: true, accent: "purple", size: "compact" },
+    { id: "overwatch", name: "Overwatch", players: "1.2M Players", live: true, accent: "orange", size: "compact" },
+    { id: "lol", name: "League of Legends", players: "1.2M Players", live: true, accent: "red", size: "compact" },
+    { id: "fortnite", name: "Fortnite", players: "850K Players", live: true, accent: "yellow", size: "compact" },
+    { id: "apex", name: "Apex Legends", players: "400K Players", live: true, accent: "pink", size: "compact" },
+    { id: "fifa", name: "FIFA", players: "1.2M Players", live: true, accent: "blue", size: "compact" },
+    { id: "cod", name: "Call of Duty", players: "850K Players", live: true, accent: "slate", size: "compact" },
+    { id: "minecraft", name: "Minecraft", players: "112M Players", live: true, accent: "orange", size: "compact" },
+  ];
+
+  const upcoming: UpcomingItem[] = [
+    { id: "u1", title: "Team A vs Team B", time: "03:45 PM", href: "/predictions?from=games_upcoming&match=team-a-vs-team-b" },
+    { id: "u2", title: "Team A vs Team B", time: "05:45 PM", href: "/predictions?from=games_upcoming&match=team-a-vs-team-b-2" },
+    { id: "u3", title: "Team A vs Team B", time: "05:45 PM", href: "/predictions?from=games_upcoming&match=team-a-vs-team-b-3" },
+  ];
+
+  return (
+    <div className="relative min-h-screen overflow-hidden bg-background">
+      <Navbar />
+
+      {/* Background */}
+      <div className="pointer-events-none absolute inset-0 cyber-grid opacity-[0.06]" />
+      <div className="pointer-events-none absolute -top-24 left-[-140px] h-[520px] w-[520px] rounded-full bg-primary/10 blur-[120px]" />
+      <div className="pointer-events-none absolute -bottom-28 right-[-140px] h-[520px] w-[520px] rounded-full bg-secondary/10 blur-[140px]" />
+      <div className="pointer-events-none absolute inset-0 opacity-[0.12] mix-blend-screen bg-[url('/images/hero-arena-background.png')] bg-cover bg-center" />
+
+      <main className="relative mx-auto w-full max-w-[1400px] px-6 pb-16 pt-28">
+        {/* Hero */}
+        <header className="relative">
+          <h1 className="text-center font-display text-5xl font-black tracking-tight text-white sm:text-6xl">
+            Game Hub
+          </h1>
+          <p className="mt-2 text-center text-base text-white/55 sm:text-lg">
+            Explore Competitive Titles
+          </p>
+          <div className="mx-auto mt-6 h-px w-full max-w-5xl bg-gradient-to-r from-transparent via-primary/60 to-transparent" />
+
+          <div className="mt-5 flex items-center justify-end">
+            <Link
+              href="/clubs?action=create"
+              className="inline-flex items-center gap-2 rounded-full border border-primary/25 bg-primary/15 px-4 py-2 text-sm font-semibold text-white shadow-[0_0_30px_rgba(0,255,255,0.12)] transition-colors hover:bg-primary/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60"
+            >
+              <Plus className="h-4 w-4" />
+              Create Club
+            </Link>
+          </div>
+        </header>
+
+        {/* Featured */}
+        <section className="mt-10">
+          <h2 className="font-display text-xl font-bold text-white">Featured</h2>
+          <div className="mt-4 grid grid-cols-1 gap-6 lg:grid-cols-3">
+            {featured.map((g) => (
