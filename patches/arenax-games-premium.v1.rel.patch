+"use client";
+
+import { ChevronRight, Plus } from "lucide-react";
+import Link from "next/link";
+
+import { Navbar } from "@/components/layout/Navbar";
+
+const accents = {
+  cyan: {
+    ring: "border-primary/25",
+    glow: "shadow-[0_0_40px_rgba(0,255,255,0.10)]",
+    icon: "text-primary",
+  },
+  blue: {
+    ring: "border-blue-400/25",
+    glow: "shadow-[0_0_40px_rgba(59,130,246,0.10)]",
+    icon: "text-blue-300",
+  },
+  red: {
+    ring: "border-red-400/25",
+    glow: "shadow-[0_0_40px_rgba(248,113,113,0.10)]",
+    icon: "text-red-300",
+  },
+  purple: {
+    ring: "border-purple-400/25",
+    glow: "shadow-[0_0_40px_rgba(168,85,247,0.10)]",
+    icon: "text-purple-300",
+  },
+  orange: {
+    ring: "border-orange-400/25",
+    glow: "shadow-[0_0_40px_rgba(251,146,60,0.10)]",
+    icon: "text-orange-300",
+  },
+  yellow: {
+    ring: "border-yellow-400/25",
+    glow: "shadow-[0_0_40px_rgba(250,204,21,0.10)]",
+    icon: "text-yellow-300",
+  },
+  pink: {
+    ring: "border-pink-400/25",
+    glow: "shadow-[0_0_40px_rgba(244,114,182,0.10)]",
+    icon: "text-pink-300",
+  },
+  slate: {
+    ring: "border-white/12",
+    glow: "shadow-[0_0_40px_rgba(255,255,255,0.06)]",
+    icon: "text-white/70",
+  },
+} as const;
+
+type Accent = keyof typeof accents;
+
+type GameCard = {
+  id: string;
+  name: string;
+  players: string;
+  live?: boolean;
+  accent: Accent;
+  size: "featured" | "compact";
+};
+
+type UpcomingItem = {
+  id: string;
+  title: string;
+  time: string;
+  href: string;
+};
+
+/**
+ * getAccentTokens
+ *
+ * @example
+ * const t = getAccentTokens("cyan");
+ * console.log(t.ring);
+ */
+function getAccentTokens(accent: Accent) {
+  return accents[accent] ?? accents.slate;
+}
+
+/**
+ * gameHref
+ *
+ * @example
+ * const url = gameHref("csgo");
+ * console.log(url);
+ */
+function gameHref(id: string) {
+  return `/predictions?game=${encodeURIComponent(id)}`;
+}
+
+function LivePill() {
+  return (
+    <span className="inline-flex items-center gap-1.5 rounded-full border border-emerald-400/25 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-200">
+      <span className="h-1.5 w-1.5 rounded-full bg-emerald-400" />
+      Live
+    </span>
+  );
+}
+
+function GameLogo({ name, accent }: { name: string; accent: Accent }) {
+  const t = getAccentTokens(accent);
+  const initials = name
+    .split(" ")
+    .filter(Boolean)
+    .slice(0, 2)
+    .map((s) => s[0] ?? "")
+    .join("")
+    .toUpperCase();
+
+  return (
+    <div
+      className={`grid h-14 w-14 place-items-center rounded-full border bg-gradient-to-br from-white/10 to-white/0 ${t.ring} ${t.glow}`}
+    >
+      <span className={`font-display text-sm font-black tracking-wide ${t.icon}`}
+        aria-hidden="true"
+      >
+        {initials}
+      </span>
+    </div>
+  );
+}
+
+function GameCardView({ game }: { game: GameCard }) {
+  const href = gameHref(game.id);
+  const t = getAccentTokens(game.accent);
+
+  const base =
+    "group relative block rounded-2xl border bg-white/[0.03] backdrop-blur-xl transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/60";
+
+  const sizeClass =
+    game.size === "featured"
+      ? "h-[92px] sm:h-[96px] px-6"
+      : "h-[86px] px-6";
+
+  return (
+    <Link
+      href={href}
+      className={`${base} ${sizeClass} border-white/10 hover:border-white/16 hover:bg-white/[0.05]`}
+    >
+      <div className="flex h-full items-center justify-between gap-6">
+        <div className="flex min-w-0 items-center gap-4">
+          <GameLogo name={game.name} accent={game.accent} />
+          <div className="min-w-0">
+            <div className="font-display text-lg font-bold text-white">
+              {game.name}
+            </div>
+            <div className="mt-1 text-sm text-white/45">{game.players}</div>
+          </div>
+        </div>
+
+        <div className="flex shrink-0 items-center gap-3">
+          {game.live ? <LivePill /> : null}
+
+          {game.size === "compact" ? (
+            <span
+              className={`inline-flex items-center justify-center rounded-full border px-4 py-2 text-sm font-semibold ${t.ring} bg-primary/15 text-white/90 shadow-[0_0_25px_rgba(0,255,255,0.12)]`}
+            >
+              Prédire
+            </span>
+          ) : null}
+
+          <ChevronRight className="h-5 w-5 text-white/35 transition-transform group-hover:translate-x-0.5" />
+        </div>
+      </div>
+    </Link>
+  );
+}
+
+export default function PremiumGameHub() {
