+}) {
+  return (
+    <div
+      className={cn(
+        "relative rounded-[28px] border border-white/10 bg-gradient-to-b from-white/7 to-white/[0.02] backdrop-blur-2xl shadow-[0_20px_80px_rgba(0,0,0,0.55)]",
