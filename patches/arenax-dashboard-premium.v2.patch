+      )}
+    >
+      <div className="absolute inset-0 rounded-[28px] bg-gradient-to-b from-white/[0.06] to-transparent pointer-events-none" />
+      <div className="relative h-full w-full">{children}</div>
+    </div>
+  );
+}
+
+/**
