+import * as React from "react";
+
+type GameEmblemProps = {
+  /** Raw game label from API/UI (e.g. "CS2", "Valorant", "Dota 2") */
+  game: string;
+  /** Pixel size (width/height). */
+  size?: number;
+  /** Optional extra classes for the <img>. */
+  className?: string;
+  /** Optional alt override. */
+  alt?: string;
+};
+
+type GameKey =
+  | "cs2"
+  | "valorant"
+  | "dota2"
+  | "lol"
+  | "wildrift"
+  | "overwatch"
+  | "rainbowsix"
+  | "rocketleague"
+  | "callofduty"
+  | "pubg"
+  | "fifa"
+  | "halo"
+  | "hearthstone"
+  | "heroesofthestorm"
+  | "pokemon"
+  | "artifact";
+
+const GAME_EMBLEM_SRC: Record<GameKey, string> = {
+  cs2: "/images/game-emblems/cs2.svg",
+  valorant: "/images/game-emblems/valorant.svg",
+  dota2: "/images/game-emblems/dota2.svg",
+  lol: "/images/game-emblems/lol.svg",
+  wildrift: "/images/game-emblems/wildrift.svg",
+  overwatch: "/images/game-emblems/overwatch.svg",
+  rainbowsix: "/images/game-emblems/rainbowsix.svg",
+  rocketleague: "/images/game-emblems/rocketleague.svg",
+  callofduty: "/images/game-emblems/callofduty.svg",
+  pubg: "/images/game-emblems/pubg.svg",
+  fifa: "/images/game-emblems/fifa.svg",
+  halo: "/images/game-emblems/halo.svg",
+  hearthstone: "/images/game-emblems/hearthstone.svg",
+  heroesofthestorm: "/images/game-emblems/heroesofthestorm.svg",
+  pokemon: "/images/game-emblems/pokemon.svg",
+  artifact: "/images/game-emblems/artifact.svg",
+};
+
+/**
+ * normalizeGameKey
+ *
+ * Maps various incoming strings (API/UI) to a stable local emblem key.
+ *
+ * @example
+ * normalizeGameKey("CS:GO") // "cs2"
+ * normalizeGameKey("Dota 2") // "dota2"
+ */
+function normalizeGameKey(game: string): GameKey {
+  const s = (game || "")
+    .toLowerCase()
+    .replace(/[\s:_-]+/g, "")
+    .trim();
+
+  if (!s) return "artifact";
+
+  // Counter-Strike
+  if (s === "cs2" || s === "csgo" || s === "csg o" || s === "counterstrike2" || s === "counterstrike") {
+    return "cs2";
+  }
+
+  // Riot titles
+  if (s === "valorant") return "valorant";
+  if (s === "lol" || s === "leagueoflegends") return "lol";
+  if (s === "wildrift" || s === "leagueoflegendswildrift") return "wildrift";
+
+  // Valve / others
+  if (s === "dota2" || s === "dota") return "dota2";
+  if (s === "overwatch" || s === "overwatch2") return "overwatch";
+  if (s === "rainbowsix" || s === "r6" || s === "r6siege" || s === "rainbowsixsiege") return "rainbowsix";
+  if (s === "rocketleague") return "rocketleague";
+  if (s === "callofduty" || s === "cod") return "callofduty";
+  if (s === "pubg") return "pubg";
+  if (s === "fifa" || s === "fc" || s === "eafc" || s === "easportsfc") return "fifa";
+  if (s === "halo") return "halo";
+  if (s === "hearthstone") return "hearthstone";
+  if (s === "heroesofthestorm" || s === "hots") return "heroesofthestorm";
+  if (s === "pokemon" || s === "pokemonunite") return "pokemon";
+
+  return "artifact";
+}
+
+/**
+ * GameEmblem
+ *
+ * Local SVG emblem for a given game string.
+ * Uses a plain <img> to avoid Next/Image remote and SVG constraints.
+ *
+ * @example
+ * <GameEmblem game="CS2" size={16} />
+ */
+export function GameEmblem({ game, size = 16, className, alt }: GameEmblemProps) {
+  const key = normalizeGameKey(game);
+  const src = GAME_EMBLEM_SRC[key] ?? GAME_EMBLEM_SRC.artifact;
+  const finalAlt = alt ?? `${game || "Game"} emblem`;
+
+  return (
+    <img
+      src={src}
+      width={size}
+      height={size}
+      alt={finalAlt}
+      loading="lazy"
+      decoding="async"
+      className={className}
+      style={{ width: size, height: size }}
+    />
+  );
+}
